<Window x:Class="InsightFactory.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InsightFactory.Desktop"
        xmlns:viewmodels="clr-namespace:InsightFactory.Desktop.ViewModels"
        xmlns:views="clr-namespace:InsightFactory.Desktop.Views"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="MES Dashboard" Height="768" Width="1024"
        Background="#F5F6F8">
    
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="MES Dashboard" FontSize="20" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Admin" FontSize="16" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <Button Content="📊 Dashboard" Command="{Binding SwitchTabCommand}" CommandParameter="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" FontSize="15" FontWeight="Bold" Foreground="#333333" Cursor="Hand"/>
                    <Button Content="📦 Products" Command="{Binding SwitchTabCommand}" CommandParameter="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" FontSize="15" FontWeight="Bold" Foreground="#333333" Cursor="Hand"/>
                    <Button Content="📝 WorkOrder" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" FontSize="15" Foreground="#555555"/>
                    <Button Content="🏭 Line" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" FontSize="15" Foreground="#555555"/>
                    <Button Content="🤖 AI Result" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" FontSize="15" Foreground="#555555"/>
                    <Button Content="📈 Reports" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" FontSize="15" Foreground="#555555"/>
                    <Button Content="⚙️ Settings" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" FontSize="15" Foreground="#555555"/>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding CurrentTabIndex}" BorderThickness="0" Background="Transparent" Margin="-2,-2,-2,-2">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Tab 0: Dashboard -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30">
                    
                    <!-- Line Status -->
                    <TextBlock Text="생산라인 현황" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                    <Border Background="White" CornerRadius="8" Padding="25" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,30">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse Width="14" Height="14" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Product Status -->
                    <TextBlock Text="제품별 품질 현황" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                    <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,30">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                        <TextBlock Text="{Binding ProductCode}" FontWeight="Bold" FontSize="16" Foreground="#2196F3" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="생산량: " FontSize="13" Foreground="#666"/>
                                            <TextBlock Text="{Binding TotalCount}" FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                                            <TextBlock Text=" 개" FontSize="13" Foreground="#666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="불량률: " FontSize="13" Foreground="#666"/>
                                            <TextBlock Text="{Binding DefectRate, StringFormat={}{0:F2}%}" FontSize="13" FontWeight="SemiBold" Foreground="#F44336"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- KPI -->
                    <TextBlock Text="KPI" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="생산량" FontSize="14" Foreground="#888" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding TotalProduction}" FontSize="28" FontWeight="Bold" Foreground="#333"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" Margin="10,0,10,0">
                            <StackPanel>
                                <TextBlock Text="불량률" FontSize="14" Foreground="#888" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding DefectRate, StringFormat={}{0:F1} %}" FontSize="28" FontWeight="Bold" Foreground="#333"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="평균 품질 지수" FontSize="14" Foreground="#888" Margin="0,0,0,2"/>
                                <TextBlock Text="* 수치가 튈 경우 불량 발생 경고" FontSize="10" Foreground="#AAA" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding AverageQuality, StringFormat={}{0:F4}}" FontSize="24" FontWeight="Bold" Foreground="#333"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="AI 예측" FontSize="14" Foreground="#888" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AiPredictionStatus}" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Charts -->
                    <Grid Height="300" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="📈 품질 지수 (Y_Quality) 추이" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                    <TextBlock Text="기준선을 벗어나는 추세가 보이면 불량 발생 확률이 높습니다." FontSize="12" Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="💡 정상 범위: 0.500 ~ 0.550 (해당 범위를 벗어나면 불량 의심)" FontSize="12" Foreground="#2196F3" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <lvc:CartesianChart Series="{Binding QualityChartSeries}" Height="200"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="5,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="📉 공정 센서 (X_1) 데이터 추이" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                </StackPanel>
                                <lvc:CartesianChart Series="{Binding SensorChartSeries}" Height="200" TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- AI Results List -->
                    <TextBlock Text="최근 AI 예측 결과" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                    <Border Background="White" CornerRadius="8" Padding="25" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,30,0">
                        <ItemsControl ItemsSource="{Binding AiResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,10">
                                        <TextBlock Text="{Binding}" FontSize="16" Foreground="#444"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                </TabItem>

                <!-- Tab 1: Products -->
                <TabItem>
                    <views:ProductManagementView/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
